# 이 파일을 복사해서 이름을 .env 로 바꾼 뒤, 키를 붙여넣으세요.
# .env 는 GitHub에 올라가지 않습니다. (이 .env.example 파일에는 키를 넣지 마세요)

GEMINI_API_KEY=여기에_키_붙여넣기

# 모델을 바꾸고 싶을 때만 앞의 #을 지우고 수정 (Google AI Studio에서 모델 이름 확인)
# GEMINI_MODEL=gemini-3.8-flash

# Supabase (로그인·내 기록) - 실제 값은 .env와 Vercel 환경변수에만
SUPABASE_URL=https://프로젝트주소.supabase.co
# 브라우저용 공개 키 (sb_publishable_...). 관리자 키(sb_secret_...)는 절대 넣지 말 것
SUPABASE_PUBLISHABLE_KEY=여기에_공개용_키
# DB 비밀번호 (CLI로 표를 만들 때만 사용, 브라우저·Vercel에는 넣지 않음)
SUPABASE_DB_PASSWORD=여기에_DB_비밀번호
